{
  "id": "dev.schweiger.dashboard",
  "version": "1.0.0",
  "compatibility": ">=13.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Web Dashboard"
  },
  "description": {
    "en": "Your Homey dashboards in any browser."
  },
  "category": [
    "tools"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Stefan Schweiger",
    "email": "st.schweiger@me.com"
  },
  "brandColor": "#2f6df0",
  "source": "https://github.com/stefan-schweiger/dev.schweiger.dashboard",
  "bugs": {
    "url": "https://github.com/stefan-schweiger/dev.schweiger.dashboard/issues"
  },
  "api": {
    "requestPairing": {
      "method": "POST",
      "path": "/pairing",
      "public": true
    },
    "getPairing": {
      "method": "GET",
      "path": "/pairing/:id",
      "public": true
    },
    "listPairings": {
      "method": "GET",
      "path": "/pairings"
    },
    "approvePairing": {
      "method": "POST",
      "path": "/pairings/:id/approve"
    },
    "declinePairing": {
      "method": "POST",
      "path": "/pairings/:id/decline"
    },
    "getApiKeyStatus": {
      "method": "GET",
      "path": "/api-key"
    },
    "setApiKey": {
      "method": "PUT",
      "path": "/api-key"
    }
  }
}
